<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!--
      Security pin: GHSA-2m69-gcr7-jv3q (High) in the bundled SQLite native library.
      As of EF Core 10.0.12, Microsoft.EntityFrameworkCore.Sqlite depends on the patched 2.1.12
      itself, so this no longer lifts anything - it is kept as an explicit floor so the advisory
      stays documented at the reference and a future EF Core patch cannot quietly drop back.
      It deliberately does NOT move to 3.0.x: that is a restructured major (no lib/ folder, a new
      SQLitePCLRaw.config.e_sqlite3 + SQLite native package pair) that Microsoft.Data.Sqlite does
      not reference, so forcing it would override what EF Core is built and tested against.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <ProjectReference Include="..\..\src\Moongazing.OrionAudit\Moongazing.OrionAudit.csproj" />
    <ProjectReference Include="..\..\src\Moongazing.OrionAudit.Testing\Moongazing.OrionAudit.Testing.csproj" />
    <!-- Direct analyzer reference: ProjectReference doesn't propagate analyzers transitively.
         A NuGet consumer gets the generator automatically via analyzers/dotnet/cs/. -->
    <ProjectReference Include="..\..\src\Moongazing.OrionAudit.Generators\Moongazing.OrionAudit.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
