<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <!-- Drives OrionAuditModuleGenerator directly (CSharpGeneratorDriver) in the generator tests,
         so they can assert on the emitted source, its diagnostics, and that it compiles. Pinned to
         the version the generator itself builds against so the driver and the generator agree. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!--
      Security pin: GHSA-2m69-gcr7-jv3q (High) in the bundled SQLite native library.
      As of EF Core 10.0.12, Microsoft.EntityFrameworkCore.Sqlite depends on the patched 2.1.12
      itself, so this no longer lifts anything - it is kept as an explicit floor so the advisory
      stays documented at the reference and a future EF Core patch cannot quietly drop back.
      It deliberately does NOT move to 3.0.x: that is a restructured major (no lib/ folder, a new
      SQLitePCLRaw.config.e_sqlite3 + SQLite native package pair) that Microsoft.Data.Sqlite does
      not reference, so forcing it would override what EF Core is built and tested against.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Moongazing.OrionAudit\Moongazing.OrionAudit.csproj" />
    <ProjectReference Include="..\..\src\Moongazing.OrionAudit.MySql\Moongazing.OrionAudit.MySql.csproj" />
    <ProjectReference Include="..\..\src\Moongazing.OrionAudit.Testing\Moongazing.OrionAudit.Testing.csproj" />
    <!-- ProjectReference does not transitively propagate analyzer items, so the generator
         needs its own direct reference (matches what NuGet does for consumers via the
         analyzers/dotnet/cs/ folder shipped in the OrionAudit package).
         ReferenceOutputAssembly is on as well so OrionAuditModuleGeneratorTests can instantiate
         the generator and drive it over its own consumer sources. -->
    <ProjectReference Include="..\..\src\Moongazing.OrionAudit.Generators\Moongazing.OrionAudit.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>
</Project>
