[*.cs]
# Test method names use Method_Scenario_Expected naming.
dotnet_diagnostic.CA1707.severity = none
# xUnit v3 generates both MicrosoftTestingPlatformEntryPoint and XunitAutoGeneratedEntryPoint by design.
dotnet_diagnostic.CS8892.severity = none
# xUnit v3 analyzer: require TestContext.Current.CancellationToken passed to every async call.
# We rely on the test harness timeout instead of plumbing the token everywhere.
dotnet_diagnostic.xUnit1051.severity = none
# Test fixtures often implement IAsyncLifetime / IAsyncDisposable without GC.SuppressFinalize.
dotnet_diagnostic.CA1816.severity = none
