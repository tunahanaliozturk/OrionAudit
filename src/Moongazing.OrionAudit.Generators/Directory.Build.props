<!--
  Roslyn analyzer hosts require netstandard2.0. This file stops the root Directory.Build.props
  (which multi-targets net8/9/10 for the publishable libraries) from leaking into the
  generator project. Same trick we use in bench/.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- A Roslyn analyzer is a compile-time component, never a runtime asset. Stop a
         consumer's `dotnet publish -p:PublishTrimmed=true` / PublishAot from trying to trim
         or AOT-compile this netstandard2.0 project (which it cannot). -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>
</Project>
