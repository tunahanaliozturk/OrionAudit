<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OrionAudit.Viewer</PackageId>
    <Description>Embeddable, framework-agnostic audit-trail viewer for OrionAudit. One endpoint registration (MapOrionAuditViewer) serves a JSON API and a built-in static UI. No Blazor dependency.</Description>
    <PackageTags>orionaudit;audit;audit-trail;viewer;efcore;aspnetcore</PackageTags>
    <PackageReadmeFile>docs/README.md</PackageReadmeFile>
    <PackageIcon>docs/logo.png</PackageIcon>
    <!-- The ASP.NET Core RouteHandlerAnalyzer (AD0001) NREs on some minimal-API delegate
         shapes; suppress its analyzer-crash diagnostic so TreatWarningsAsErrors does not
         block the build. We still get route-handler runtime correctness from the framework. -->
    <NoWarn>$(NoWarn);AD0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Moongazing.OrionAudit\Moongazing.OrionAudit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="docs/README.md" Pack="true" PackagePath="docs/" />
    <None Include="docs/logo.png" Pack="true" PackagePath="docs/" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>
  <!--
    API freeze. OrionAudit 1.0.0 declared the public surface stable, so every addition or removal
    has to be written down: RS0016 fires when a public member is missing from the baseline, RS0017
    when the baseline names one the code no longer has. With TreatWarningsAsErrors on, both are
    build breaks. New public API goes in PublicAPI.Unshipped.txt; the release cut promotes it into
    PublicAPI.Shipped.txt.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.11.0-beta1.24508.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
