<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OrionAudit</PackageId>
    <Description>EF Core change audit trail with JSON Patch diffs, multi-tenant support, time-travel reconstruction, and OpenTelemetry instrumentation.</Description>
    <PackageTags>audit;audit-trail;efcore;entity-framework;change-tracking;json-patch;compliance;ddd</PackageTags>
    <PackageReadmeFile>docs/README.md</PackageReadmeFile>
    <PackageIcon>docs/logo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Convergence (v0.11.1): the shared Orion family primitives. SafeObserverInvoker backs the
      fault-safe IAuditCaptureObserver invocation (replacing the bespoke try/catch). Internal-use
      dependency only - no OrionAudit public type exposes an Orion.Abstractions type.
    -->
    <PackageReference Include="Orion.Abstractions" Version="1.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <!-- EF Core 10 only supports net10.0, so net8.0/net9.0 stay on the latest EF Core 9 patch. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.20" />
  </ItemGroup>

  <ItemGroup>
    <None Include="docs/README.md" Pack="true" PackagePath="docs/" />
    <None Include="docs/logo.png" Pack="true" PackagePath="docs/" />
  </ItemGroup>

  <!-- Expose internal building blocks (the hash-chain writer and the canonicalization helper) to
       the test assemblies so they can be unit-tested without widening the public API surface. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Moongazing.OrionAudit.Tests" />
    <InternalsVisibleTo Include="Moongazing.OrionAudit.IntegrationTests" />
  </ItemGroup>

  <!--
    Ship the source generator inside the same NuGet (analyzers/dotnet/cs/) rather than as a
    separate package. ReferenceOutputAssembly=false means we don't link the generator dll
    into the runtime library; OutputItemType=Analyzer tells MSBuild to load it as a
    compile-time analyzer when this project (and downstream consumers) build.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Moongazing.OrionAudit.Generators\Moongazing.OrionAudit.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Moongazing.OrionAudit.Generators\bin\$(Configuration)\netstandard2.0\Moongazing.OrionAudit.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>
  <!--
    API freeze. OrionAudit 1.0.0 declared the public surface stable, so every addition or removal
    has to be written down: RS0016 fires when a public member is missing from the baseline, RS0017
    when the baseline names one the code no longer has. With TreatWarningsAsErrors on, both are
    build breaks. New public API goes in PublicAPI.Unshipped.txt; the release cut promotes it into
    PublicAPI.Shipped.txt.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.11.0-beta1.24508.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
