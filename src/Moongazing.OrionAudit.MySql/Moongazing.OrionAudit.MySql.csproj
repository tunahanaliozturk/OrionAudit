<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OrionAudit.MySql</PackageId>
    <Description>MySQL / MariaDB provider integration for OrionAudit. Adds a ModelBuilder extension that applies the OrionAudit entity configurations with MySQL-aware column types (JSON or LONGTEXT for the diff/snapshot payloads).</Description>
    <PackageTags>audit;audit-trail;efcore;mysql;mariadb;json;pomelo</PackageTags>
    <PackageReadmeFile>docs/README.md</PackageReadmeFile>
    <PackageIcon>docs/logo.png</PackageIcon>
  </PropertyGroup>

  <!-- EF Core 10 only supports net10.0, so net8.0/net9.0 stay on the latest EF Core 9 patch. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.20" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moongazing.OrionAudit\Moongazing.OrionAudit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="docs/README.md" Pack="true" PackagePath="docs/" />
    <None Include="docs/logo.png" Pack="true" PackagePath="docs/" />
  </ItemGroup>
  <!--
    API freeze. OrionAudit 1.0.0 declared the public surface stable, so every addition or removal
    has to be written down: RS0016 fires when a public member is missing from the baseline, RS0017
    when the baseline names one the code no longer has. With TreatWarningsAsErrors on, both are
    build breaks. New public API goes in PublicAPI.Unshipped.txt; the release cut promotes it into
    PublicAPI.Shipped.txt.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.11.0-beta1.24508.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
