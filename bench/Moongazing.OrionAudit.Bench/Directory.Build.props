<!--
  This file deliberately stops the root Directory.Build.props (which multi-targets net8/9/10
  for the publishable libraries) from reaching BenchmarkDotNet's auto-generated bootstrap
  csproj that lives under bin/Release/.../BenchmarkDotNet-1/. BDN's bootstrap restores
  against net8/net9 and would otherwise fail because the bench project itself only ships
  net10.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
</Project>
